<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Matricula" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:message id="Message_Request" name="Solicitação de cobrança"/><bpmn:message id="Message_Confirmation" name="Confirmação de pagamento"/>
<bpmn:collaboration id="Collaboration_Matricula">
<bpmn:participant id="Participant_Faculdade" name="Faculdade" processRef="Process_Matricula"/>
<bpmn:participant id="Participant_Pagamento" name="Sistema de pagamento" processRef="Process_Pagamento"/>
<bpmn:messageFlow id="MessageFlow_Request" name="Solicitar cobrança" sourceRef="Task_EnviarCobranca" targetRef="Start_Pagamento" messageRef="Message_Request"/>
<bpmn:messageFlow id="MessageFlow_Confirmation" name="Confirmar pagamento" sourceRef="End_Pagamento" targetRef="Task_RegistrarPagamento" messageRef="Message_Confirmation"/>
</bpmn:collaboration>
<bpmn:process id="Process_Matricula" name="Matrícula de aluno" isExecutable="false">
<bpmn:laneSet id="LaneSet_Faculdade">
<bpmn:lane id="Lane_Aluno" name="Aluno"><bpmn:flowNodeRef>Start_Matricula</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Preencher</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Corrigir</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SelecionarCurso</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Secretaria" name="Secretaria acadêmica"><bpmn:flowNodeRef>Task_Conferir</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Documentos</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Paralelo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Validar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EnviarCobranca</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarPagamento</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Juntar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Confirmar</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Matricula</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start_Matricula" name="Solicitação recebida"/><bpmn:task id="Task_Preencher" name="Preencher formulário de matrícula"/><bpmn:task id="Task_Conferir" name="Conferir documentos"/><bpmn:exclusiveGateway id="Gateway_Documentos" name="Documentos completos?"/><bpmn:task id="Task_Corrigir" name="Corrigir dados ou documentos"/><bpmn:task id="Task_SelecionarCurso" name="Selecionar curso e turma"/><bpmn:parallelGateway id="Gateway_Paralelo" name="Iniciar verificações em paralelo" gatewayDirection="Diverging"/><bpmn:task id="Task_Validar" name="Validar pré-requisitos"/><bpmn:task id="Task_EnviarCobranca" name="Enviar solicitação de cobrança"/><bpmn:task id="Task_RegistrarPagamento" name="Registrar confirmação do pagamento"/><bpmn:parallelGateway id="Gateway_Juntar" name="Verificações concluídas" gatewayDirection="Converging"/><bpmn:task id="Task_Confirmar" name="Confirmar matrícula"/><bpmn:endEvent id="End_Matricula" name="Matrícula efetivada"/>
<bpmn:sequenceFlow id="F1" sourceRef="Start_Matricula" targetRef="Task_Preencher"/><bpmn:sequenceFlow id="F2" sourceRef="Task_Preencher" targetRef="Task_Conferir"/><bpmn:sequenceFlow id="F3" sourceRef="Task_Conferir" targetRef="Gateway_Documentos"/><bpmn:sequenceFlow id="F4_Sim" name="Sim" sourceRef="Gateway_Documentos" targetRef="Task_SelecionarCurso"/><bpmn:sequenceFlow id="F4_Nao" name="Não" sourceRef="Gateway_Documentos" targetRef="Task_Corrigir"/><bpmn:sequenceFlow id="F5" sourceRef="Task_Corrigir" targetRef="Task_Preencher"/><bpmn:sequenceFlow id="F6" sourceRef="Task_SelecionarCurso" targetRef="Gateway_Paralelo"/><bpmn:sequenceFlow id="F7" sourceRef="Gateway_Paralelo" targetRef="Task_Validar"/><bpmn:sequenceFlow id="F8" sourceRef="Gateway_Paralelo" targetRef="Task_EnviarCobranca"/><bpmn:sequenceFlow id="F9" sourceRef="Task_Validar" targetRef="Gateway_Juntar"/><bpmn:sequenceFlow id="F10" sourceRef="Task_EnviarCobranca" targetRef="Task_RegistrarPagamento"/><bpmn:sequenceFlow id="F11" sourceRef="Task_RegistrarPagamento" targetRef="Gateway_Juntar"/><bpmn:sequenceFlow id="F12" sourceRef="Gateway_Juntar" targetRef="Task_Confirmar"/><bpmn:sequenceFlow id="F13" sourceRef="Task_Confirmar" targetRef="End_Matricula"/>
</bpmn:process>
<bpmn:process id="Process_Pagamento" name="Processamento de pagamento" isExecutable="false">
<bpmn:startEvent id="Start_Pagamento" name="Cobrança recebida"><bpmn:messageEventDefinition id="StartMessageDefinition" messageRef="Message_Request"/></bpmn:startEvent><bpmn:task id="Task_ProcessarPagamento" name="Processar pagamento"/><bpmn:endEvent id="End_Pagamento" name="Resultado enviado"><bpmn:messageEventDefinition id="EndMessageDefinition" messageRef="Message_Confirmation"/></bpmn:endEvent><bpmn:sequenceFlow id="PF1" sourceRef="Start_Pagamento" targetRef="Task_ProcessarPagamento"/><bpmn:sequenceFlow id="PF2" sourceRef="Task_ProcessarPagamento" targetRef="End_Pagamento"/>
</bpmn:process>

